# Copy to .env for local development and replace the placeholders. Never commit the real .env.

# --- Genesys AudioHook authorization (value Genesys sends in the x-api-key header) ---
GENESYS_API_KEY=<your_genesys_audiohook_api_key>

# --- Default AI vendor: openai | gemini | grok (xai is accepted as an alias) ---
# A call can switch vendor with the AI_VENDOR session variable when that vendor's key is configured here.
AI_VENDOR=openai

# --- Vendor API keys (only the vendors you use are required) ---
OPENAI_API_KEY=<your_openai_api_key>
GEMINI_API_KEY=<your_gemini_api_key>
XAI_API_KEY=<your_xai_api_key>

# --- Per-vendor default models and voices ---
# OpenAI Realtime: gpt-realtime-2.1 | gpt-realtime-2.1-mini | gpt-realtime-2 ...  GPT-Live: gpt-live-1
OPENAI_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin
# Gemini Live: gemini-3.8-live | gemini-3.8-live-extended-thinking | gemini-3.1-flash-live-preview
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
# xAI Voice Agent: grok-voice-3.0 | grok-voice-latest
GROK_MODEL=grok-voice-3.0
GROK_VOICE=eve
# Legacy overrides that apply to the default vendor only
# AI_MODEL=
# AI_VOICE=

# --- OpenAI Realtime tuning ---
# OPENAI_REASONING_EFFORT=low          # minimal | low | medium | high | xhigh (gpt-realtime-2* models)
# OPENAI_TURN_DETECTION=semantic_vad   # semantic_vad | server_vad
# OPENAI_VAD_EAGERNESS=auto            # low | medium | high | auto (semantic_vad only)
# OPENAI_NOISE_REDUCTION=              # near_field | far_field

# --- OpenAI GPT-Live (used when the OpenAI model is gpt-live-*) ---
# OPENAI_LIVE_DELEGATION_MODEL=gpt-6-luna
# OPENAI_LIVE_DELEGATION_REASONING_EFFORT=
# OPENAI_LIVE_SERVICE_TIER=            # auto | default | flex | priority

# --- Gemini Live tuning ---
# GEMINI_THINKING_LEVEL=               # extended-thinking: low | medium | high; 3.1 flash live: minimal..high
# GEMINI_VAD_SILENCE_DURATION_MS=700
# GEMINI_VAD_PREFIX_PADDING_MS=100
# GEMINI_VAD_START_SENSITIVITY=        # HIGH | LOW
# GEMINI_VAD_END_SENSITIVITY=          # HIGH | LOW
# GEMINI_CONTEXT_COMPRESSION=true
# GEMINI_SESSION_RESUMPTION=true
# GEMINI_GOOGLE_SEARCH=false
# GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite

# --- xAI Grok Voice tuning ---
# GROK_REASONING_EFFORT=               # high | none
# GROK_IDLE_TIMEOUT_MS=                # re-engage a silent caller after this many ms
# GROK_SPEECH_SPEED=                   # 0.7 - 1.5
# GROK_KEYTERMS=                       # comma-separated product names / proper nouns for ASR biasing

# --- Persona defaults (overridable per call with the AGENT_NAME / COMPANY_NAME session variables) ---
# AGENT_NAME=AI Assistant
# COMPANY_NAME=Our Company

# --- Genesys Cloud data actions (optional, for function calling) ---
# GENESYS_CLIENT_ID=<your_genesys_oauth_client_id>
# GENESYS_CLIENT_SECRET=<your_genesys_oauth_client_secret>
# GENESYS_REGION=mypurecloud.com

DEBUG=false
